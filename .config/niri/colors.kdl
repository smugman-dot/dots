layout {
	background-color "#1a1111"

    focus-ring {
        active-color "#ffb3b1"
        inactive-color "#a08c8b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb3b1"
        inactive-color "#a08c8b"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb3b1"
        inactive-color "#a08c8b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb3b180"
    }
}

overview {
	backdrop-color "#1a1111"
}

recent-windows {
    highlight {
        active-color "#ffb3b1"
        urgent-color "#ffb4ab"
    }
}
